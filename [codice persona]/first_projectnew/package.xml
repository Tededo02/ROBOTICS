<?xml version="1.0"?>
<package format="2">
  <name>first_project</name>
  <version>0.0.1</version>
  <description>Pacchetto ROS per odometria GPS, odometro e gestione dei tempi di settore.</description>

  <maintainer email="tu@email.com">
    Il Tuo Nome
  </maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- Dipendenze necessarie sia per il build che per il runtime -->
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>message_generation</depend>
  <depend>message_runtime</depend>

  <export>
    <!-- Niente da esportare per ora -->
  </export>
</package>