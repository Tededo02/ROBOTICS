<launch>


<env name="XDG_RUNTIME_DIR" value="/tmp/runtime"/>

<node pkg="first_project" type="odometer" name="odometer" output="screen">
    <param name="odom_frame" value="odom"/>
    <param name="child_frame" value="vehicle"/>
</node>

<node pkg="first_project" type="gps_odometer" name="gps_odometer" output="screen">
    <param name="odom_frame" value="odom_gps"/>
    <param name="child_frame" value="gps"/>
</node>

<node pkg="first_project" type="sector_times" name="sector_times" output="screen">
    <param name="sector_topic" value="/sector_times"/>
</node>

 <node pkg="rviz" type="rviz" name="rviz" args="-d $(find first_project)/cfg/project_config.rviz"/>

    <!-- Parametri di riferimento (lat_r, lon_r, alt_r).
         Puoi impostarli con i valori desiderati. -->gps_odometer
    <param name="gps_odometer/lat_r" value="45.000000" />
    <param name="gps_odometer/lon_r" value="9.000000" />
    <param name="gps_odometer/alt_r" value="1.0" />


</launch>